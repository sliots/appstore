# Public origin of the deployed Cloudflare Pages site (no trailing slash).
PUBLIC_BASE_URL=https://signall-app-source.pages.dev

# Public origin for the R2 bucket or its custom domain (no trailing slash).
R2_PUBLIC_BASE_URL=https://ipa.example.com

# Optional. Used by npm run ipa:upload when --bucket is omitted.
R2_BUCKET=signall-ipa
